# Copy to .env and fill in. You need ONE provider key: OPENAI_API_KEY or GOOGLE_API_KEY.
# Gemini setup (free tier at https://aistudio.google.com):
#   GOOGLE_API_KEY=...
#   CHAT_MODEL=google_genai:gemini-3.5-flash
#   UTILITY_MODEL=google_genai:gemini-3.5-flash-lite   # own free-tier quota
#   EMBEDDING_MODEL=google_genai:gemini-embedding-001
#   MAX_CONCURRENCY=2   # stay under free-tier rate limits

# ---- Models -----------------------------------------------------------
OPENAI_API_KEY=
# Any init_chat_model id works, e.g. anthropic:claude-sonnet-4-5 (pip install langchain-anthropic)
CHAT_MODEL=openai:gpt-4o-mini
UTILITY_MODEL=openai:gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
CHAT_TEMPERATURE=0.3

# ---- Optional tool keys (tools appear only when a key is set) -------------
# Better web search for chat + CRAG fallback (DuckDuckGo is used otherwise)
TAVILY_API_KEY=
# get_stock_price tool  (https://www.alphavantage.co/support/#api-key)
ALPHAVANTAGE_API_KEY=
# get_weather tool       (https://weatherstack.com)
WEATHERSTACK_API_KEY=

# ---- LangSmith tracing -------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nexus-chatbot

# ---- Persistence -------------------------------------------------------
# Leave empty for SQLite (data/). For Postgres run `docker compose up -d` and use:
# POSTGRES_URI=postgresql://postgres:postgres@localhost:5442/postgres?sslmode=disable
POSTGRES_URI=
DATA_DIR=data
KNOWLEDGE_DIR=data/knowledge

# ---- RAG / Corrective RAG ----------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=4
CRAG_UPPER_THRESHOLD=0.7
CRAG_LOWER_THRESHOLD=0.3
# Sentence-level refinement costs one cheap LLM call per sentence (run in parallel)
CRAG_REFINE=true
CRAG_WEB_FALLBACK=true
MAX_CONCURRENCY=8

# ---- Memory ------------------------------------------------------------
MAX_CONTEXT_TOKENS=6000
SUMMARIZE_AFTER_MESSAGES=24
KEEP_RECENT_MESSAGES=6
LONG_TERM_MEMORY=true
# Embed memories and recall only the most relevant ones (needs sqlite-vec or Postgres pgvector)
SEMANTIC_MEMORY=false
MEMORY_RECALL_LIMIT=20

# ---- MCP ---------------------------------------------------------------
MCP_CONFIG=mcp_servers.json
